// Settings for SonarQube for IDE (sonarlint-vscode), applied before any
// settings given on the command line.
{
  "sonarlint.disableTelemetry": true,
  "sonarlint.pathToCompileCommands": "${compileCommands}",
  // The extension starts its language server with monitoring (error
  // reporting) enabled. JVM arguments from this setting come after the
  // extension's own, so these take precedence. Keep them when overriding
  // this setting.
  "sonarlint.ls.vmargs": "-Dsonarlint.monitoring.enabled=false -Dsonarlint.telemetry.disabled=true",
}
